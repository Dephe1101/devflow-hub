// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  name         String
  passwordHash String?     // Allow null for OAuth users
  authProvider String?     @default("LOCAL") // "LOCAL", "GOOGLE", "GITHUB"
  googleId     String?     @unique
  githubId     String?     @unique
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
  tags         Tag[]
  agentDevices AgentDevice[]
  launchLogs   LaunchLog[]

  @@map("user")
}

model AgentDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String   @unique
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  
  @@index([userId])
  @@map("agent_device")
}

model Workspace {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String              @db.VarChar(100)
  description    String?             @db.VarChar(500)
  color          String?             @db.VarChar(7)
  icon           String?
  sortOrder      Int                 @default(0)
  isPinned       Boolean             @default(false)
  lastLaunchedAt DateTime?
  launchCount    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  resources      WorkspaceResource[]
  tags           WorkspaceTag[]
  notes          Note[]
  launchLogs     LaunchLog[]

  @@index([userId, isPinned, sortOrder], name: "idx_workspace_user_pinned")
  @@map("workspace")
}

model Resource {
  id              String              @id @default(uuid()) @db.Uuid
  createdByUserId String              @db.Uuid
  type            String              @db.VarChar(20) // "URL", "LOCAL_PATH", "APP_URI", "COMMAND"
  value           String
  displayName     String?             @db.VarChar(100)
  faviconUrl      String?
  healthStatus    String?             @default("UNKNOWN") @db.VarChar(20)
  lastHealthCheck DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspaces      WorkspaceResource[]
  tags            ResourceTag[]
  notes           Note[]

  @@index([createdByUserId, type], name: "idx_resource_user_type")
  @@map("resource")
}

model WorkspaceResource {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  resourceId  String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, resourceId])
  @@index([workspaceId, sortOrder], name: "idx_workspace_resource_order")
  @@map("workspace_resource")
}

model Tag {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String         @db.VarChar(50)
  color       String?        @db.VarChar(7)
  resources   ResourceTag[]
  workspaces  WorkspaceTag[]

  @@unique([userId, name])
  @@map("tag")
}

model ResourceTag {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @db.Uuid
  tagId      String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([resourceId, tagId])
  @@map("resource_tag")
}

model WorkspaceTag {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  tagId       String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tagId])
  @@map("workspace_tag")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resourceId  String?   @db.Uuid
  resource    Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(200)
  content     String?   @db.Text
  type        String    @db.VarChar(20) // "NOTE" | "COMMAND" | "SNIPPET"
  category    String?   @db.VarChar(50) // "Build" | "Deploy" | "Database"...
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, type], name: "idx_note_workspace_type")
  @@index([resourceId], name: "idx_note_resource")
  @@map("note")
}

model LaunchLog {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String   @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?  @db.Uuid
  results          Json?
  webUrlsOpened    Int      @default(0)
  localPathsOpened Int      @default(0)
  failedCount      Int      @default(0)
  status           String   @db.VarChar(20)
  launchedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, launchedAt], name: "idx_launch_log_workspace")
  @@index([userId, launchedAt], name: "idx_launch_log_user")
  @@map("launch_log")
}
