{
  "manifest_version": 3,
  "name": "DevFlow Hub Extension",
  "version": "1.0.0",
  "description": "Browser Extension for DevFlow Hub",
  "permissions": ["tabs", "tabGroups", "storage", "activeTab", "scripting"],
  "host_permissions": ["__WEB_APP_URL__", "__API_ORIGIN__"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["__WEB_APP_URL__"],
      "js": ["assets/content.js"]
    }
  ]
}
