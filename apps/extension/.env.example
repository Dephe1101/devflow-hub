# DevFlow Hub Extension — Environment Variables
# Copy this file to .env and update values for your environment.
# These variables are injected at BUILD TIME via Vite (import.meta.env.VITE_*)

# Backend API base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:4000/api

# Web App URL — used for content script auth sync and redirect
VITE_WEB_APP_URL=http://localhost:3000
